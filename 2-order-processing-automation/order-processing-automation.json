{
  "name": "Order Processing Automation (fixed)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Order Processing Automation",
        "formDescription": "Submit your order details. You will receive an email once your order has been reviewed.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Customer Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Customer Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Order Type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Normal"
                  },
                  {
                    "option": "Urgent"
                  },
                  {
                    "option": "Bulk"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Order Amount",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Order Description",
              "fieldType": "textarea"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -640,
        0
      ],
      "id": "37a17c2f-1dde-4d4d-a78d-3a51ce4d49ee",
      "name": "On form submission"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7a75b0cb-32d7-436b-8df2-88775afcaa41",
              "name": "Submitted At",
              "type": "string",
              "value": "={{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }}"
            },
            {
              "id": "7cde8ff4-4bf1-4f43-bbba-966a124ae1c1",
              "name": "Priority",
              "type": "string",
              "value": "={{ ({ 'Normal': 'Medium', 'Urgent': 'High', 'Bulk': 'Low' })[$json['Order Type']] || 'Medium' }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        -400,
        0
      ],
      "id": "0fab51f6-c7b4-4318-b3d1-83fe9c914689",
      "name": "Prepare Order"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer Name: {{ $json['Customer Name'] }}\nCustomer Email: {{ $json['Customer Email'] }}\nOrder Type: {{ $json['Order Type'] }}\nOrder Amount: {{ $json['Order Amount'] }}\nOrder Description: {{ $json['Order Description'] || 'Not provided' }}\nPriority: {{ $json['Priority'] }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an order-review assistant for a small business.\nYou receive one customer order with: customer name, email, order type (Normal, Urgent or Bulk), amount, description and priority (High, Medium or Low).\n\nDecide the status:\n- \"Approved\" if the details are complete and consistent, the amount is greater than 0 and not above 50000, and the description is clear or not needed.\n- \"Needs Review\" if the amount is above 50000, the description is missing or unclear for an Urgent or Bulk order, or anything looks inconsistent or suspicious.\n\nThen return:\n- status: \"Approved\" or \"Needs Review\"\n- summary: one sentence an internal team member can read at a glance, including the reason for the status\n- email_subject: a clear subject line. For Approved, a confirmation to the customer. For Needs Review, an internal alert that mentions the customer name and priority.\n- email_body: a short, professional plain-text email. For Approved, address the customer by name, confirm the order type, amount and expected handling according to priority, and sign off with: Regards, Order Desk. For Needs Review, write to the internal reviewer with all order details and the reason it needs review.\nNever invent delivery dates, prices or policies. Output only the structured result."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -160,
        0
      ],
      "id": "08f492fd-359f-4405-9ff9-5ceec26d6bb5",
      "name": "AI Order Review"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5-5",
          "cachedResultName": "Claude Sonnet 5.5"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        -240,
        220
      ],
      "id": "8d3e5aa2-8563-4ed2-92eb-d4249d4e49c6",
      "name": "Anthropic Chat Model"
    },
    {
